{
  "rewrites": [
    {
      "source": "/dzr-proxy/:path*",
      "destination": "https://dzr.tabs-vs-spaces.wtf/:path*"
    },
    {
      "source": "/music-api-proxy/:path*",
      "destination": "https://music-api.geeked.wtf/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ]
    }
  ]
}
